[Unit]
Description=headliner read-only web viewer
After=network.target

[Service]
Type=simple
User=headliner
Group=headliner
StateDirectory=headliner
StateDirectoryMode=0750
WorkingDirectory=/var/lib/headliner
# Listens on localhost only: Tailscale Serve (tailscale serve --bg --https 8444
# http://127.0.0.1:8090) is the way in. To serve the home network too, override it:
#   systemctl edit headliner-web   ->   [Service] / ExecStart= / ExecStart=... --host 0.0.0.0 ...
ExecStart=/opt/headliner/venv/bin/headliner web --host 127.0.0.1 --port 8090 --sources /etc/headliner/sources.yaml --db /var/lib/headliner/headlines.db
Restart=on-failure
RestartSec=5
UMask=0077
# The viewer opens the database read-only; the state directory stays writable
# only because SQLite readers of a WAL database update its shared-memory file.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
